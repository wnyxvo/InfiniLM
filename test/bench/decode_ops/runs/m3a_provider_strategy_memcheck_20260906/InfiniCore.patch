+
+// Capacity-only strategy for decode when no per-step host lengths are exposed.
+// It deliberately favors one split once batch parallelism is already ample.
+inline int chooseNumSplitsCapacityStrategy(size_t num_heads, size_t num_seqs,
+                                           size_t seqlen_k, int sm_count) {
+    if (sm_count <= 0 || num_heads == 0 || num_seqs == 0 || seqlen_k <= 256) return 1;
+    if (num_seqs >= 8) return 1;
+    if (num_seqs <= 2) {
+        if (seqlen_k >= 4096) return 8;
+        if (seqlen_k >= 1024) return 4;
+        return 2;
+    }
+    if (seqlen_k >= 2048) return 4;
+    if (seqlen_k >= 1024) return 2;
+    return 1;
+}
